    const defaultIndex = user.discriminator && user.discriminator !== "0"
      ? discriminator % 5
      : Number((BigInt(user.id) >> 22n) % 6n);
    return `https://cdn.discordapp.com/embed/avatars/${defaultIndex}.png`;
