  // --- Current Discord Account Avatar ---
  const hasMethod = (value, method) => {
    let current = value;
    for (let depth = 0; current && depth < 10; depth++) {
      try {
        const descriptor = Object.getOwnPropertyDescriptor(current, method);
        if (typeof descriptor?.value === "function" || typeof descriptor?.get === "function") return true;
        current = Object.getPrototypeOf(current);
      } catch { break; }
    }
    return false;
  };

  const findUserStore = () => {
    const seen = new WeakSet();
    const visit = (value, depth = 0) => {
      if (!value || (typeof value !== "object" && typeof value !== "function") ||
          seen.has(value) || depth > 3) return null;
      seen.add(value);

      if (hasMethod(value, "getCurrentUser")) {
        try {
          const user = value.getCurrentUser();
          if (user?.id) return value;
        } catch {}
      }

      let children = [];
      try { children = Object.values(value); } catch {}
      for (const child of children) {
        const found = visit(child, depth + 1);
        if (found) return found;
      }
      return null;
    };

    for (const module of Object.values(wpRequire.c)) {
      const found = visit(module?.exports);
      if (found) return found;
    }
    return null;
  };

