  header.addEventListener("pointermove", e => {
    if (!isPanelDragging) return;
    panelX = Math.max(0, Math.min(window.innerWidth - panel.offsetWidth, initialX + e.clientX - startX));
    panelY = Math.max(0, Math.min(window.innerHeight - panel.offsetHeight, initialY + e.clientY - startY));
    panel.style.transform = `translate3d(${panelX}px, ${panelY}px, 0)`;
  });
  header.addEventListener("pointerup", e => {
    isPanelDragging = false;
    header.releasePointerCapture(e.pointerId);
  });

  // FAB Drag & Double Click
  let clickCount = 0, clickTimer = null;
  fab.addEventListener("pointerdown", e => {
    isFabDragging = true; hasMoved = false;
    startX = e.clientX; startY = e.clientY;
    initialX = fabX; initialY = fabY;
    fab.setPointerCapture(e.pointerId);
  });
  fab.addEventListener("pointermove", e => {
    if (!isFabDragging) return;
    hasMoved = true;
    fabX = Math.max(0, Math.min(window.innerWidth - fab.offsetWidth, initialX + e.clientX - startX));
    fabY = Math.max(0, Math.min(window.innerHeight - fab.offsetHeight, initialY + e.clientY - startY));
    fab.style.transform = `translate3d(${fabX}px, ${fabY}px, 0)`;
  });
  fab.addEventListener("pointerup", e => {
    isFabDragging = false;
    fab.releasePointerCapture(e.pointerId);
    if (!hasMoved) {
      clickCount++;
      if (clickCount === 1) {
        clickTimer = setTimeout(() => { clickCount = 0; }, 300);
      } else if (clickCount === 2) {
        clearTimeout(clickTimer); clickCount = 0;
        maximizePanel();
      }
    }
  });

  const minimizePanel = () => {
    refreshAccountAvatar();
    const btnRect = $("minimizeBtn").getBoundingClientRect();
    fabX = Math.max(0, Math.min(window.innerWidth - fab.offsetWidth, btnRect.left + (btnRect.width / 2) - (fab.offsetWidth / 2)));
    fabY = Math.max(0, Math.min(window.innerHeight - fab.offsetHeight, btnRect.top + (btnRect.height / 2) - (fab.offsetHeight / 2)));
    
    fab.style.transform = `translate3d(${fabX}px, ${fabY}px, 0) scale(0.3)`;
    fab.style.display = "block";
    
    requestAnimationFrame(() => {
      fab.style.transition = "transform 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275), width 0.2s, height 0.2s";
      fab.style.transform = `translate3d(${fabX}px, ${fabY}px, 0) scale(1)`;
      setTimeout(() => { fab.style.transition = "width 0.2s, height 0.2s"; }, 200);
    });
    
    panel.style.display = "none";
    log("Minimized. Double-click icon to open.", "info");
  };

  const maximizePanel = () => {
    fab.style.display = "none";
    panel.style.display = "flex";
    
    panelX = Math.max(0, Math.min(window.innerWidth - panel.offsetWidth, fabX - panel.offsetWidth / 2));
    panelY = Math.max(0, Math.min(window.innerHeight - panel.offsetHeight, fabY - 20));
    
    panel.style.transform = `translate3d(${panelX}px, ${panelY}px, 0) scale(0.85)`;
    panel.style.opacity = "0";
    
    requestAnimationFrame(() => {
      panel.style.transition = "transform 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275), opacity 0.25s ease";
      panel.style.transform = `translate3d(${panelX}px, ${panelY}px, 0) scale(1)`;
      panel.style.opacity = "1";
      setTimeout(() => { panel.style.transition = ""; }, 250);
    });
  };

  const log = (msg, type = "info") => {
    const el = document.createElement("div");
    el.className = "log-entry " + type;
    el.textContent = `[${new Date().toLocaleTimeString()}] ${msg}`;
    logEl.appendChild(el);
    logEl.scrollTop = logEl.scrollHeight;
    console.log(`[QM] ${msg}`);
  };

  // --- Notification Logic ---
  const playNotificationSound = () => {
    try {
      const ctx = new (window.AudioContext || window.webkitAudioContext)();
      const o = ctx.createOscillator();
      const g = ctx.createGain();
      o.connect(g);
      g.connect(ctx.destination);
      
      o.type = "sine";
      o.frequency.setValueAtTime(800, ctx.currentTime);
      o.frequency.exponentialRampToValueAtTime(1200, ctx.currentTime + 0.1);
      
      g.gain.setValueAtTime(0, ctx.currentTime);
      g.gain.linearRampToValueAtTime(0.1, ctx.currentTime + 0.05);
      g.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + 0.5);
      
      o.start();
      o.stop(ctx.currentTime + 0.5);
    } catch (e) {}
  };

  const showToast = (questName) => {
    if (panel.style.display !== "none") return;
    playNotificationSound();

    const toast = document.createElement("div");
    toast.className = "toast-notification";
    
    const isRight = (fabX + settings.fabSize / 2) > (window.innerWidth / 2);
    const isBottom = (fabY + settings.fabSize / 2) > (window.innerHeight / 2);
    
    let xPos = isRight ? fabX - 240 : fabX + settings.fabSize + 15;
    let yPos = isBottom ? fabY - 60 : fabY;

    if (xPos < 10) xPos = 10;
    if (xPos + 260 > window.innerWidth) xPos = window.innerWidth - 270;
    if (yPos < 10) yPos = 10;

    toast.style.left = `${xPos}px`;
    toast.style.top = `${yPos}px`;

    toast.innerHTML = `
      <div class="toast-icon">✓</div>
      <div class="toast-text">
        <div class="toast-title">Quest Completed</div>
        <div class="toast-desc" title="${questName}">${questName}</div>
      </div>
    `;

    $("toastContainer").appendChild(toast);

    requestAnimationFrame(() => {
      toast.classList.add("show");
    });

    setTimeout(() => {
      toast.classList.remove("show");
      setTimeout(() => toast.remove(), 300); 
    }, 5000);
  };

  // --- Settings Logic ---
  $("settingsBtn").addEventListener("click", () => $("settingsModal").classList.add("show"));
  $("closeSettings").addEventListener("click", () => $("settingsModal").classList.remove("show"));

  $("colorPicker").addEventListener("input", (e) => {
    const color = e.target.value;
    settings.theme = color;
    panel.style.setProperty('--accent-color', color);
    fab.style.setProperty('--accent-color', color);
  });

  $("panelSize").addEventListener("input", (e) => {
    settings.size = e.target.value;
    $("sizeVal").textContent = settings.size;
    panel.style.width = `${settings.size}px`;
  });

  $("fabSize").addEventListener("input", (e) => {
    settings.fabSize = e.target.value;
    $("fabSizeVal").textContent = settings.fabSize;
    fab.style.width = `${settings.fabSize}px`;
    fab.style.height = `${settings.fabSize}px`;
  });

  // --- Custom Modal Logic ---
  const closeModalOverlay = $("closeModalOverlay");
  
  $("closeBtn").addEventListener("click", () => closeModalOverlay.classList.add("show"));
  $("modalCancel").addEventListener("click", () => closeModalOverlay.classList.remove("show"));
  $("modalConfirm").addEventListener("click", () => {
    closeModalOverlay.classList.remove("show");
    activeJobs.forEach((job, id) => stopJob(id));
    root.remove();
  });

  // --- Logic ---
  const getEligibleQuests = () => {
    try {
      return [...QuestsStore.quests.values()].filter(q => {
        if (!q || !q.userStatus || !q.config) return false;
        if (!q.userStatus.enrolledAt || q.userStatus.completedAt) return false;
        if (new Date(q.config.expiresAt).getTime() <= Date.now()) return false;
        
        const taskKeys = Object.keys((q.config.taskConfig || q.config.taskConfigV2).tasks || {});
        if (!supportedTasks.some(t => taskKeys.includes(t))) return false;
        
        return true;
      });
    } catch { return []; }
  };

  const getArchivedQuests = () => {
    try {
      return [...QuestsStore.quests.values()].filter(q => {
        if (!q || !q.userStatus || !q.config) return false;
        // Only show completed quests
        return q.userStatus.completedAt;
      });
    } catch { return []; }
  };

  const getUnenrolledQuests = () => {
    try {
      return [...QuestsStore.quests.values()].filter(q => {
        if (!q || !q.config) return false;
        if (q.userStatus?.completedAt) return false;
        if (new Date(q.config.expiresAt).getTime() <= Date.now()) return false;
        const taskKeys = Object.keys((q.config.taskConfig || q.config.taskConfigV2).tasks || {});
        if (!supportedTasks.some(t => taskKeys.includes(t))) return false;
        
        return !q.userStatus?.enrolledAt;
      });
    } catch { return []; }
  };

  const getQuestTask = (quest) => {
    const tc = quest.config?.taskConfig ?? quest.config?.taskConfigV2;
    if (!tc || !tc.tasks) return null;
    const taskName = supportedTasks.find(t => tc.tasks[t] != null);
    return taskName ? { taskName, taskData: tc.tasks[taskName] } : null;
  };

  const getQuestProgress = (quest) => {
    try {
      const t = getQuestTask(quest); if (!t) return { current: 0, target: 0 };
      const live = QuestsStore.quests.get(quest.id) ?? quest;
      const status = live.userStatus;
      if (!status) return { current: 0, target: 0 };
      const current = live.config?.configVersion === 1
        ? (status.streamProgressSeconds ?? 0)
        : (status.progress?.[t.taskName]?.value ?? 0);
      return { current: Math.floor(current), target: t.taskData?.target || 0 };
    } catch { return { current: 0, target: 0 }; }
  };

  const formatTime = (seconds) => {
    if (seconds < 60) return `${Math.floor(seconds)}s`;
    const m = Math.floor(seconds / 60);
    const s = Math.floor(seconds % 60);
    return `${m}m ${s}s`;
  };

  const getTaskColor = (taskName) => {
    if (taskName === "PLAY_ON_DESKTOP") return "#1dd1a1";
    if (taskName === "WATCH_VIDEO" || taskName === "WATCH_VIDEO_ON_MOBILE") return "#ff9f43";
    if (taskName === "PLAY_ACTIVITY") return "#a55eea";
    if (taskName === "STREAM_ON_DESKTOP") return "#9b59b6";
    return "#5865f2";
  };

  const renderControls = () => {
    if (currentView === "quests") {
      controlsEl.innerHTML = `
        <div class="btn-row">
          <button id="archiveBtn" class="btn-archive">🗄️ Archive</button>
        </div>
        <div class="btn-row">
          <button id="startSelected" class="btn-start">▶ Selected</button>
          <button id="startAll" class="btn-all">⚡ All Quests</button>
        </div>
        <div class="btn-row">
          <button id="stopAll" class="btn-stop">■ Stop All</button>
          <button id="updateBtn" class="btn-update">⟳ Update</button>
        </div>
      `;
      // Re-attach listeners
      $("archiveBtn").addEventListener("click", () => {
        currentView = "archive";
        render();
      });
      $("startSelected").addEventListener("click", () => {
        if (selectedQuests.size === 0) return log("No quests selected!", "warn");
        log(`Starting ${selectedQuests.size} selected quest(s)...`, "success");
        selectedQuests.forEach(id => {
          const q = QuestsStore.quests.get(id);
          if (q) runJob(q);
        });
        render();
      });
      $("startAll").addEventListener("click", () => {
        const quests = getEligibleQuests();
        if (quests.length === 0) return log("No quests found.", "info");
        log(`Starting all ${quests.length} quests...`, "success");
        quests.forEach(q => runJob(q));
        render();
      });
      $("stopAll").addEventListener("click", () => {
        activeJobs.forEach((job, id) => stopJob(id));
        log("Stopped all running tasks.", "info");
        render();
      });
      $("updateBtn").addEventListener("click", handleEnrollAndUpdate);
      $("updateBtn").addEventListener("contextmenu", (e) => {
        e.preventDefault();
        checkUpdateFromGitHub();
      });
    } else if (currentView === "archive") {
      controlsEl.innerHTML = `
        <div class="btn-row">
          <button id="refreshArchiveBtn" class="btn-refresh">⟳ Refresh History</button>
        </div>
        <div class="btn-row">
          <button id="backBtn" class="btn-back">⬅ Back to Quests</button>
        </div>
      `;
      $("refreshArchiveBtn").addEventListener("click", () => {
        log("Refreshing archive history...", "info");
        render();
      });
      $("backBtn").addEventListener("click", () => {
        currentView = "quests";
        render();
      });
    }
  };

  const render = () => {
    if (currentView === "quests") {
      const quests = getEligibleQuests();
      $("fabBadge").textContent = quests.length > 0 ? quests.length : "";
      
      if (quests.length === 0) {
        listEl.innerHTML = `<div style="text-align:center; color:#949ba4; padding:20px;">No quests found.</div>`;
        renderControls();
        return;
      }
      
      listEl.innerHTML = quests.map(q => {
        const t = getQuestTask(q); if (!t) return "";
        const color = getTaskColor(t.taskName); 
        
        const qName = q.config.messages?.questName || q.id;
        const isChecked = selectedQuests.has(q.id) ? "checked" : "";
        
        let { current, target } = getQuestProgress(q);
        if (liveTimes.has(q.id)) {
          current = liveTimes.get(q.id);
        }

        const pct = target > 0 ? Math.min(100, (current / target) * 100) : 0;
        const isRunning = activeJobs.has(q.id);

        const badgeClass = t.taskName.toLowerCase();
        const progressBg = isRunning 
          ? `linear-gradient(90deg, ${color} 0%, color-mix(in srgb, ${color} 60%, #fff) 50%, ${color} 100%)`
          : '#5865f2';

        return `<div class="quest" style="--quest-color: ${color}" data-id="${q.id}">
          <div class="quest-main">
            <input type="checkbox" data-id="${q.id}" ${isChecked}>
            <div class="quest-info">
              <div class="quest-title">
                <span class="quest-name">${qName}</span>
                <span class="task-badge ${badgeClass}">${t.taskName.replace(/_/g, " ")}</span>
              </div>
            </div>
          </div>
          <div class="progress-container">
            <div class="progress-text">
              <span class="cur-time">${formatTime(current)}</span>
              <span class="tgt-time">${formatTime(target)}</span>
            </div>
            <div class="progress-bar-bg">
              <div class="progress-bar-fill ${isRunning ? 'running' : ''}" style="width: ${pct}%; background: ${progressBg}; box-shadow: ${isRunning ? `0 0 10px ${color}` : 'none'};"></div>
            </div>
          </div>
        </div>`;
      }).join("");

      listEl.querySelectorAll(".quest-main").forEach(el => {
        el.addEventListener("click", (e) => {
          if (e.target.tagName === "INPUT") return; 
          const id = el.parentElement.dataset.id;
          const cb = el.querySelector("input[type=checkbox]");
          cb.checked = !cb.checked;
          if (cb.checked) selectedQuests.add(id);
          else selectedQuests.delete(id);
        });
      });

      listEl.querySelectorAll("input[type=checkbox]").forEach(cb => {
        cb.addEventListener("change", (e) => {
          const id = e.target.dataset.id;
          if (e.target.checked) selectedQuests.add(id);
          else selectedQuests.delete(id);
        });
      });
    } else if (currentView === "archive") {
      const archived = getArchivedQuests();
      
      if (archived.length === 0) {
        listEl.innerHTML = `<div style="text-align:center; color:#949ba4; padding:20px;">No archived quests found.</div>`;
        renderControls();
        return;
      }

      listEl.innerHTML = archived.map(q => {
        const t = getQuestTask(q); if (!t) return "";
        const color = getTaskColor(t.taskName); 
        const qName = q.config.messages?.questName || q.id;

        return `<div class="quest" style="--quest-color: ${color}; opacity: 0.7;">
          <div class="quest-main" style="cursor: default;">
            <div style="width: 20px; height: 20px; display: flex; align-items: center; justify-content: center; color: #1dd1a1; font-weight: bold;">✓</div>
            <div class="quest-info">
              <div class="quest-title">
                <span class="quest-name">${qName}</span>
                <span class="task-badge ${t.taskName.toLowerCase()}">${t.taskName.replace(/_/g, " ")}</span>
              </div>
            </div>
          </div>
          <div class="progress-container">
            <div class="progress-text">
              <span style="color: #1dd1a1;">Completed</span>
              <span class="tgt-time">${formatTime(t.taskData?.target || 0)}</span>
            </div>
            <div class="progress-bar-bg">
              <div class="progress-bar-fill" style="width: 100%; background: ${color}; box-shadow: none;"></div>
            </div>
          </div>
        </div>`;
      }).join("");
    }
    renderControls();
  };

  // --- Real Quest Logic (Spoofing) ---
  const activeFakeGames = new Set();
  let realGetRunningGames = null, realGetGameForPID = null, spoofActive = false;

  const ensureSpoof = () => {
    if (spoofActive) return;
    realGetRunningGames = RunningGameStore.getRunningGames.bind(RunningGameStore);
    realGetGameForPID   = RunningGameStore.getGameForPID.bind(RunningGameStore);
    RunningGameStore.getRunningGames = () => [...realGetRunningGames(), ...activeFakeGames];
    RunningGameStore.getGameForPID   = (pid) => [...activeFakeGames].find(x => x.pid === pid) ?? realGetGameForPID(pid);
    spoofActive = true;
  };
  
  const refreshGames = (added = [], removed = []) => {
    FluxDispatcher.dispatch({ type: "RUNNING_GAMES_CHANGE", removed, added, games: [...activeFakeGames] });
  };
  
  const addFake = (g) => { ensureSpoof(); activeFakeGames.add(g); refreshGames([g]); };
  const removeFake = (g) => {
    activeFakeGames.delete(g); refreshGames([], [g]);
    if (activeFakeGames.size === 0 && spoofActive) {
      RunningGameStore.getRunningGames = realGetRunningGames;
      RunningGameStore.getGameForPID   = realGetGameForPID;
      spoofActive = false;
      FluxDispatcher.dispatch({ type: "RUNNING_GAMES_CHANGE", removed: [], added: [], games: [] });
    }
  };

  const runJob = (quest) => {
    if (activeJobs.has(quest.id)) return;
    const t = getQuestTask(quest); if (!t) return;
    const { taskName, taskData } = t;
    const applicationId = quest.config.application?.id ?? taskData.applications?.[0]?.id;
    const secondsNeeded = taskData.target;
    const questName = quest.config.messages?.questName ?? quest.id;
    const pid = Math.floor(Math.random() * 30000) + 1000;
    
    const state = { aborted: false, cleanup: () => {} };
    activeJobs.set(quest.id, state);

    let secondsDone = quest.userStatus?.progress?.[taskName]?.value ?? 0;
    liveTimes.set(quest.id, secondsDone);

    const finish = (ok = true) => {
      activeJobs.delete(quest.id);
      liveTimes.delete(quest.id);
      if (ok) { 
        log(`✅ Completed: ${questName}`, "success"); 
        showToast(questName);
      }
      render();
    };

    if (taskName === "WATCH_VIDEO" || taskName === "WATCH_VIDEO_ON_MOBILE") {
      const speed = 10; 
      let completed = false;
      
      (async () => {
        const tickInterval = setInterval(() => {
          if (!state.aborted && secondsDone < secondsNeeded) {
            secondsDone = Math.min(secondsNeeded, secondsDone + 1);
            liveTimes.set(quest.id, secondsDone);
            
            const qEl = listEl.querySelector(`.quest[data-id="${quest.id}"]`);
            if (qEl) {
              const pct = Math.min(100, (secondsDone / secondsNeeded) * 100);
              qEl.querySelector(".progress-bar-fill").style.width = pct + "%";
              qEl.querySelector(".cur-time").textContent = formatTime(secondsDone);
            }
          }
        }, 1000);

        while (!state.aborted) {
          const remaining = Math.min(speed, secondsNeeded - secondsDone);
          if (remaining <= 0) break;
          
          await new Promise(r => setTimeout(r, remaining * 1000 + (Math.random() * 1000 - 500)));
          if (state.aborted) return;
          
          try {
            const res = await api.post({ url: `/quests/${quest.id}/video-progress`,
              body: { timestamp: Math.min(secondsNeeded, secondsDone + speed + Math.random()) } });
            completed = res.body?.completed_at != null;
            
            const actualDone = Math.min(secondsNeeded, secondsDone + speed);
            liveTimes.set(quest.id, actualDone);
            secondsDone = actualDone;
            
          } catch (e) { log(`Video error: ${e.message}`, "error"); }
          
          if (secondsDone >= secondsNeeded) break;
          render();
        }

        clearInterval(tickInterval);

        if (!state.aborted && !completed) {
          try { await api.post({ url: `/quests/${quest.id}/video-progress`, body: { timestamp: secondsNeeded } }); } catch {}
        }
        if (!state.aborted) finish(true);
      })();
      
      log(`▶ Video started: ${questName}`, "info");
      state.cleanup = () => { state.aborted = true; };
      return;
    }

    if (taskName === "PLAY_ON_DESKTOP") {
      if (!isApp) { log(`❌ ${questName}: needs Discord desktop app.`, "error"); activeJobs.delete(quest.id); return; }
      api.get({ url: `/applications/public?application_ids=${applicationId}` }).then(res => {
        if (state.aborted) return;
        const appData = res.body[0];
        const exeName = appData.executables?.find(x => x.os === "win32")?.name?.replace(">", "") ?? appData.name.replace(/[\/\\:*?"<>|]/g, "");
        const fakeGame = {
          cmdLine: `C:\\Program Files\\${appData.name}\\${exeName}`, exeName,
          exePath: `c:/program files/${appData.name.toLowerCase()}/${exeName}`,
          hidden: false, isLauncher: false, id: applicationId, name: appData.name,
          pid, pidPath: [pid], processName: appData.name, start: Date.now(),
        };
        addFake(fakeGame);
        
        const onBeat = (data) => {
          if (state.aborted) return;
          const p = data.userStatus?.progress?.PLAY_ON_DESKTOP?.value ?? 0;
          liveTimes.set(quest.id, p);
          secondsDone = p;
          render();
          if (p >= secondsNeeded) {
            FluxDispatcher.unsubscribe("QUESTS_SEND_HEARTBEAT_SUCCESS", onBeat);
            removeFake(fakeGame);
            finish(true);
          }
        };
        FluxDispatcher.subscribe("QUESTS_SEND_HEARTBEAT_SUCCESS", onBeat);
        state.cleanup = () => {
          FluxDispatcher.unsubscribe("QUESTS_SEND_HEARTBEAT_SUCCESS", onBeat);
          removeFake(fakeGame);
        };
        log(`▶ Game spoofed: ${appData.name}`, "info");
      }).catch(e => { log(`Fetch app error: ${e.message}`, "error"); activeJobs.delete(quest.id); });
      return;
    }

    if (taskName === "STREAM_ON_DESKTOP") {
      if (!isApp) { log(`❌ ${questName}: needs Discord desktop app.`, "error"); activeJobs.delete(quest.id); return; }
      if ([...activeJobs.values()].some(j => j._isStream)) {
        log(`⚠ Only one STREAM quest at a time.`, "warn");
        activeJobs.delete(quest.id); return;
      }
      state._isStream = true;
      const realMeta = ApplicationStreamingStore.getStreamerActiveStreamMetadata;
      ApplicationStreamingStore.getStreamerActiveStreamMetadata = () => ({ id: applicationId, pid, sourceName: null });
      
      const onBeat = (data) => {
        if (state.aborted) return;
        const p = data.userStatus?.progress?.STREAM_ON_DESKTOP?.value ?? 0;
        liveTimes.set(quest.id, p);
        secondsDone = p;
        render();
        if (p >= secondsNeeded) {
          FluxDispatcher.unsubscribe("QUESTS_SEND_HEARTBEAT_SUCCESS", onBeat);
          ApplicationStreamingStore.getStreamerActiveStreamMetadata = realMeta;
          finish(true);
        }
      };
      FluxDispatcher.subscribe("QUESTS_SEND_HEARTBEAT_SUCCESS", onBeat);
      state.cleanup = () => {
        FluxDispatcher.unsubscribe("QUESTS_SEND_HEARTBEAT_SUCCESS", onBeat);
        ApplicationStreamingStore.getStreamerActiveStreamMetadata = realMeta;
      };
      log(`▶ Stream spoofed: ${questName}`, "info");
      return;
    }

    if (taskName === "PLAY_ACTIVITY") {
      let channelId = ChannelStore.getSortedPrivateChannels()[0]?.id;
      if (!channelId) {
        const g = Object.values(GuildChannelStore.getAllGuilds()).find(x => x?.VOCAL?.length > 0);
        channelId = g?.VOCAL[0]?.channel?.id;
      }
      if (!channelId) { log(`❌ ${questName}: no voice channel found.`, "error"); activeJobs.delete(quest.id); return; }
