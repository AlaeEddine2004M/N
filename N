  const isOrbQuest = (q) => {
    try {
      const rewards = q.config?.rewards || [];
      if (rewards.some(r => r.type === 4 || r.type === 5 || (r.messages?.name && r.messages.name.toLowerCase().includes("orb")))) return true;
      const name = q.config?.messages?.questName || "";
      if (name.toLowerCase().includes("orb")) return true;
      return false;
    } catch { return false; }
  };

  const getAutoPlay = () => {
    try {
      const v = localStorage.getItem(AUTOPLAY_KEY);
      return v === null ? true : v === "1";
    } catch { return true; }
  };
