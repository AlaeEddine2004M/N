  const getEligibleQuests = () => {
    try {
      if (!QuestsStore || !QuestsStore.quests) return [];
      const vals = [...QuestsStore.quests.values()];
      
      return vals.filter(q => {
        try {
          if (!q || !q.userStatus || !q.config) return false;
          if (!q.userStatus.enrolledAt || q.userStatus.completedAt) return false;
          if (!q.config.expiresAt || new Date(q.config.expiresAt).getTime() <= Date.now()) return false;
          
          const taskConfig = q.config.taskConfig || q.config.taskConfigV2;
          if (!taskConfig || typeof taskConfig !== 'object') return false;
          
          const tasks = taskConfig.tasks;
          if (!tasks || typeof tasks !== 'object') return false;
          
          const taskKeys = Object.keys(tasks);
          if (!Array.isArray(taskKeys)) return false;
          
          const isValidTask = supportedTasks.some(t => taskKeys.includes(t));
          if (!isValidTask) return false;

          if (orbsOnly && !isOrbQuest(q)) return false;

          return true;
        } catch (err) { return false; }
      });
    } catch (err) { return []; }
  };

  const getUnenrolledQuests = () => {
    try {
      if (!QuestsStore || !QuestsStore.quests) return [];
      const vals = [...QuestsStore.quests.values()];
      return vals.filter(q => {
        try {
          if (!q || !q.config) return false;
          if (q.userStatus?.completedAt) return false;
          if (!q.config.expiresAt || new Date(q.config.expiresAt).getTime() <= Date.now()) return false;
          
          const taskConfig = q.config.taskConfig || q.config.taskConfigV2;
          if (!taskConfig || typeof taskConfig !== 'object') return false;
          
          const tasks = taskConfig.tasks;
          if (!tasks || typeof tasks !== 'object') return false;
          
          const taskKeys = Object.keys(tasks);
          if (!supportedTasks.some(t => taskKeys.includes(t))) return false;

          if (orbsOnly && !isOrbQuest(q)) return false;

          return !q.userStatus?.enrolledAt;
        } catch { return false; }
      });
    } catch { return []; }
  };

  const getQuestTask = (quest) => {
    try {
      const tc = quest.config?.taskConfig ?? quest.config?.taskConfigV2;
      if (!tc || !tc.tasks) return null;
      const taskName = supportedTasks.find(t => tc.tasks[t] != null);
      if (!taskName) return null;
      return { taskName, taskData: tc.tasks[taskName] };
    } catch { return null; }
  };

