    const animate = () => {
      if (!isDragging) return;
      currentX += (targetX - currentX) * 0.25;
      currentY += (targetY - currentY) * 0.25;
      pos.x = currentX; pos.y = currentY;
      element.style.transform = `translate3d(${currentX}px, ${currentY}px, 0) scale(1)`;
      rAF_ID = requestAnimationFrame(animate);
    };
    
    handle.addEventListener("pointerdown", e => {
      if (isAnimating) return;
      if (e.target.closest("button") && !isFab) return;
      
      isDragging = true;
      startX = e.clientX; startY = e.clientY;
      initialX = pos.x; initialY = pos.y;
      targetX = pos.x; targetY = pos.y;
      currentX = pos.x; currentY = pos.y;
      
      handle.setPointerCapture(e.pointerId);
      if (!isFab) element.classList.add("is-dragging");
      if (isFab) animate();
    });

    handle.addEventListener("pointermove", e => {
      if (!isDragging) return;
      
      targetX = Math.max(0, Math.min(window.innerWidth - element.offsetWidth, initialX + e.clientX - startX));
      targetY = Math.max(0, Math.min(window.innerHeight - element.offsetHeight, initialY + e.clientY - startY));
      
      if (!isFab) {
        pos.x = targetX; pos.y = targetY;
        if (rAF_ID) cancelAnimationFrame(rAF_ID);
        rAF_ID = requestAnimationFrame(() => {
          element.style.transform = `translate3d(${targetX}px, ${targetY}px, 0) scale(1)`;
        });
      }
    });

    handle.addEventListener("pointerup", e => {
      if (!isDragging) return;
      isDragging = false;
      handle.releasePointerCapture(e.pointerId);
      if (!isFab) element.classList.remove("is-dragging");
      if (rAF_ID) cancelAnimationFrame(rAF_ID);
      
      if (isFab) {
        pos.x = targetX; pos.y = targetY;
        element.style.transform = `translate3d(${targetX}px, ${targetY}px, 0) scale(1)`;
      }

      const distMoved = Math.hypot(e.clientX - startX, e.clientY - startY);
      if (isFab && distMoved < 5) maximizePanel();
    });
  };

  makeDraggable(panel, header, panelPos, false);
  makeDraggable(fab, fab, fabPos, true);

  const minimizePanel = () => {
    if (isAnimating) return;
    isAnimating = true;
    const btnRect = minimizeBtn.getBoundingClientRect();
    
    fabPos.x = Math.max(0, Math.min(window.innerWidth - 64, btnRect.left + (btnRect.width / 2) - 32));
    fabPos.y = Math.max(0, Math.min(window.innerHeight - 64, btnRect.top + (btnRect.height / 2) - 32));

    const rect = panel.getBoundingClientRect();
    const cx = rect.left + rect.width / 2;
    const cy = rect.top + rect.height / 2;
    const tx = fabPos.x + 32;
    const ty = fabPos.y + 32;
    
    const dx = tx - cx;
    const dy = ty - cy;
    const scale = 64 / rect.width;

    panel.style.transformOrigin = "center center";
    panel.classList.add("morphing");
    panel.offsetHeight;

    panel.style.transform = `translate3d(${panelPos.x + dx}px, ${panelPos.y + dy}px, 0) scale(${scale})`;
    panel.style.borderRadius = "50%";
    panel.style.background = "#232428";
    panel.style.boxShadow = "0 8px 24px rgba(0, 0, 0, 0.4)";

    setTimeout(() => {
      panel.style.display = "none";
      panel.classList.remove("morphing");
      panel.style.transform = ""; panel.style.borderRadius = "";
      panel.style.background = ""; panel.style.boxShadow = ""; panel.style.transformOrigin = "";
      
      fab.style.display = "flex";
      fab.style.transform = `translate3d(${fabPos.x}px, ${fabPos.y}px, 0) scale(1)`;
      fab.style.opacity = "1";
      
      setTimeout(() => { isAnimating = false; }, 50);
    }, 450);
  };

  const maximizePanel = () => {
    if (isAnimating) return;
    isAnimating = true;

    fab.style.display = "none";
    panelPos.x = Math.max(0, Math.min(window.innerWidth - panel.offsetWidth, panelPos.x));
    panelPos.y = Math.max(0, Math.min(window.innerHeight - panel.offsetHeight, panelPos.y));
    
    const rect = panel.getBoundingClientRect();
    const targetCx = fabPos.x + 32;
    const targetCy = fabPos.y + 32;
    const panelCx = panelPos.x + rect.width / 2;
    const panelCy = panelPos.y + rect.height / 2;
    
    const dx = targetCx - panelCx;
    const dy = targetCy - panelCy;
    const scale = 64 / rect.width;

    panel.style.display = "flex";
    panel.style.transformOrigin = "center center";
    panel.style.transition = "none";
    panel.style.transform = `translate3d(${panelPos.x + dx}px, ${panelPos.y + dy}px, 0) scale(${scale})`;
    panel.style.borderRadius = "50%";
    panel.style.background = "#232428";
    panel.style.boxShadow = "0 8px 24px rgba(0, 0, 0, 0.4)";
    
    panel.offsetHeight;
    panel.classList.add("morphing");
    
    requestAnimationFrame(() => {
      panel.style.transform = `translate3d(${panelPos.x}px, ${panelPos.y}px, 0) scale(1)`;
      panel.style.borderRadius = "20px";
      panel.style.background = "rgba(20, 21, 24, 0.85)";
      panel.style.boxShadow = "0 25px 60px rgba(0,0,0,0.7), inset 0 0 0 1px rgba(255,255,255,0.08)";

      setTimeout(() => {
        panel.style.transition = ""; panel.style.transformOrigin = "";
        panel.classList.remove("morphing");
        isAnimating = false;
      }, 450);
    });
  };

  const openModal = (title, desc, confirmText, isDanger, onConfirm) => {
    $("modalTitle").textContent = title;
    $("modalDesc").textContent = desc;
    const confirmBtn = $("modalConfirm");
    confirmBtn.textContent = confirmText;
    confirmBtn.className = isDanger ? "danger" : "primary";
    $("modalCancel").onclick = () => closeModal.classList.remove("show");
    confirmBtn.onclick = () => { closeModal.classList.remove("show"); if (onConfirm) onConfirm(); };
    closeModal.classList.add("show");
  };

  const log = (msg, type = "info") => {
    const el = document.createElement("div");
    el.className = "log-entry " + type;
    el.textContent = `[${new Date().toLocaleTimeString()}] ${msg}`;
    logEl.appendChild(el);
    if (logEl.children.length > 100) logEl.firstChild.remove();
    logEl.scrollTop = logEl.scrollHeight;
    console.log(`[QM] ${msg}`);
  };

  const activeFakeGames = new Set();
  let realGetRunningGames = null, realGetGameForPID = null, spoofActive = false;

  const ensureSpoof = () => {
    if (spoofActive) return;
    realGetRunningGames = RunningGameStore.getRunningGames.bind(RunningGameStore);
    realGetGameForPID   = RunningGameStore.getGameForPID.bind(RunningGameStore);
    RunningGameStore.getRunningGames = () => [...realGetRunningGames(), ...activeFakeGames];
    RunningGameStore.getGameForPID   = (pid) => [...activeFakeGames].find(x => x.pid === pid) ?? realGetGameForPID(pid);
    spoofActive = true;
  };
  
  const refreshGames = (added = [], removed = []) => {
    FluxDispatcher.dispatch({ type: "RUNNING_GAMES_CHANGE", removed, added, games: [...activeFakeGames] });
  };
  
  const addFake = (g) => { ensureSpoof(); activeFakeGames.add(g); refreshGames([g]); };
  const removeFake = (g) => {
    activeFakeGames.delete(g); refreshGames([], [g]);
    if (activeFakeGames.size === 0 && spoofActive) {
      RunningGameStore.getRunningGames = realGetRunningGames;
      RunningGameStore.getGameForPID   = realGetGameForPID;
      spoofActive = false;
      FluxDispatcher.dispatch({ type: "RUNNING_GAMES_CHANGE", removed: [], added: [], games: [] });
    }
  };

  const jobs = new Map();
  const selected = new Set();
  let lastIds = "";

  const runJob = (quest) => {
    if (jobs.has(quest.id)) return;
    const t = getQuestTask(quest); if (!t) return;
    const { taskName, taskData } = t;
    const applicationId = quest.config.application?.id ?? taskData.applications?.[0]?.id;
    const secondsNeeded = taskData.target;
    const questName = quest.config.messages?.questName ?? quest.id;
    const pid = Math.floor(Math.random() * 30000) + 1000;
    const state = { aborted: false, cleanup: () => {} };
    jobs.set(quest.id, state);

    const finish = (ok = true) => {
      jobs.delete(quest.id);
      if (ok) { log(`✅ Completed: ${questName}`, "success"); beep(); }
      render();
    };

    const randomDelay = (baseMs) => baseMs + (Math.random() * 2000 - 1000);

    if (taskName === "WATCH_VIDEO" || taskName === "WATCH_VIDEO_ON_MOBILE") {
      let secondsDone = quest.userStatus?.progress?.[taskName]?.value ?? 0;
      const speed = 10; 
      let completed = false;
      
      (async () => {
        while (!state.aborted) {
          const remaining = Math.min(speed, secondsNeeded - secondsDone);
          if (remaining <= 0) break;
          await new Promise(r => setTimeout(r, remaining * 1000 + randomDelay(0)));
          if (state.aborted) return;
          try {
            const res = await api.post({ url: `/quests/${quest.id}/video-progress`,
              body: { timestamp: Math.min(secondsNeeded, secondsDone + speed + Math.random()) } });
            completed = res.body?.completed_at != null;
            secondsDone = Math.min(secondsNeeded, secondsDone + speed);
          } catch (e) { log(`Video error: ${e.message}`, "error"); }
          if (secondsDone >= secondsNeeded) break;
        }
        if (!state.aborted && !completed) {
          try { await api.post({ url: `/quests/${quest.id}/video-progress`, body: { timestamp: secondsNeeded } }); } catch {}
        }
        if (!state.aborted) finish(true);
      })();
      log(`▶ Video spoof started: ${questName} (Fast Mode)`, "info");
      state.cleanup = () => { state.aborted = true; };
      return;
    }

    if (taskName === "PLAY_ON_DESKTOP") {
      if (!isApp) { log(`❌ ${questName}: needs Discord desktop app.`, "error"); jobs.delete(quest.id); return; }
      api.get({ url: `/applications/public?application_ids=${applicationId}` }).then(res => {
        if (state.aborted) return;
        const appData = res.body[0];
        const exeName = appData.executables?.find(x => x.os === "win32")?.name?.replace(">", "") ?? appData.name.replace(/[\/\\:*?"<>|]/g, "");
        const fakeGame = {
          cmdLine: `C:\\Program Files\\${appData.name}\\${exeName}`,
          exeName, exePath: `c:/program files/${appData.name.toLowerCase()}/${exeName}`,
          hidden: false, isLauncher: false, id: applicationId, name: appData.name,
          pid, pidPath: [pid], processName: appData.name, start: Date.now(),
        };
        addFake(fakeGame);
        state.cleanup = () => removeFake(fakeGame);
        const onBeat = (data) => {
          if (state.aborted) return;
          const p = data.userStatus?.progress?.PLAY_ON_DESKTOP?.value ?? 0;
          if (p >= secondsNeeded) {
            FluxDispatcher.unsubscribe("QUESTS_SEND_HEARTBEAT_SUCCESS", onBeat);
            removeFake(fakeGame);
            finish(true);
          }
        };
        FluxDispatcher.subscribe("QUESTS_SEND_HEARTBEAT_SUCCESS", onBeat);
        state.cleanup = () => {
          FluxDispatcher.unsubscribe("QUESTS_SEND_HEARTBEAT_SUCCESS", onBeat);
          removeFake(fakeGame);
        };
        log(`▶ Game spoofed: ${appData.name} (Wait ~${Math.ceil((secondsNeeded - getQuestProgress(quest).current) / 60)} min)`, "info");
      }).catch(e => { log(`Fetch app error: ${e.message}`, "error"); jobs.delete(quest.id); });
      return;
    }

    if (taskName === "STREAM_ON_DESKTOP") {
      if (!isApp) { log(`❌ ${questName}: needs Discord desktop app.`, "error"); jobs.delete(quest.id); return; }
      if ([...jobs.keys()].some(id => jobs.get(id)._isStream)) {
        log(`⚠ Only one STREAM quest at a time.`, "warn");
        jobs.delete(quest.id); return;
      }
      state._isStream = true;
      const realMeta = ApplicationStreamingStore.getStreamerActiveStreamMetadata;
      ApplicationStreamingStore.getStreamerActiveStreamMetadata = () => ({ id: applicationId, pid, sourceName: null });
      const onBeat = (data) => {
        if (state.aborted) return;
        const p = data.userStatus?.progress?.STREAM_ON_DESKTOP?.value ?? 0;
        if (p >= secondsNeeded) {
          FluxDispatcher.unsubscribe("QUESTS_SEND_HEARTBEAT_SUCCESS", onBeat);
          ApplicationStreamingStore.getStreamerActiveStreamMetadata = realMeta;
          finish(true);
        }
      };
      FluxDispatcher.subscribe("QUESTS_SEND_HEARTBEAT_SUCCESS", onBeat);
      state.cleanup = () => {
        FluxDispatcher.unsubscribe("QUESTS_SEND_HEARTBEAT_SUCCESS", onBeat);
        ApplicationStreamingStore.getStreamerActiveStreamMetadata = realMeta;
      };
      log(`▶ Stream spoofed: ${questName} (Remember to be in a VC!)`, "info");
      return;
    }

    if (taskName === "PLAY_ACTIVITY") {
      let channelId = ChannelStore.getSortedPrivateChannels()[0]?.id;
      if (!channelId) {
        const g = Object.values(GuildChannelStore.getAllGuilds()).find(x => x?.VOCAL?.length > 0);
        channelId = g?.VOCAL[0]?.channel?.id;
      }
      if (!channelId) { log(`❌ ${questName}: no voice channel found.`, "error"); jobs.delete(quest.id); return; }
      const streamKey = `call:${channelId}:1`;
      (async () => {
        log(`▶ Activity spoof started: ${questName}`, "info");
        while (!state.aborted) {
          try {
            const res = await api.post({ url: `/quests/${quest.id}/heartbeat`, body: { stream_key: streamKey, terminal: false } });
            const p = res.body?.progress?.PLAY_ACTIVITY?.value ?? 0;
            if (p >= secondsNeeded) {
              await api.post({ url: `/quests/${quest.id}/heartbeat`, body: { stream_key: streamKey, terminal: true } });
              break;
            }
          } catch (e) { log(`Activity error: ${e.message}`, "error"); }
          await new Promise(r => setTimeout(r, randomDelay(20000)));
        }
        if (!state.aborted) finish(true);
      })();
      state.cleanup = () => { state.aborted = true; };
      return;
    }
  };

  const stopJob = (id) => {
    const j = jobs.get(id); if (!j) return;
    j.cleanup(); j.aborted = true; jobs.delete(id);
    log(`■ Stopped job.`, "warn");
    render();
  };

  const render = () => {
    try {
      const quests = getEligibleQuests();
      const unenrolled = getUnenrolledQuests();
      
      btnEnroll.textContent = autoPlay ? `➕ Auto-Enroll + Play (${unenrolled.length})` : `➕ Auto-Enroll (${unenrolled.length})`;
      btnEnroll.classList.toggle("autoplay", autoPlay);
      btnEnroll.disabled = unenrolled.length === 0;

      const ids = quests.map(q => q.id).sort().join(",");
      
      if (ids !== lastIds) {
        lastIds = ids;
        if (quests.length === 0) {
          listEl.innerHTML = `
            <div class="empty">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <path d="M8 14s1.5 2 4 2 4-2 4-2"></path>
                <line x1="9" y1="9" x2="9.01" y2="9"></line>
                <line x1="15" y1="9" x2="15.01" y2="9"></line>
              </svg>
              <span>No ${orbsOnly ? "Orbs " : ""}quests found.<br>Check back later or update Discord.</span>
            </div>`;
        } else {
          listEl.innerHTML = quests.map(q => {
            const t = getQuestTask(q);
            if (!t) return "";
            const color = taskColors[t.taskName] || "#5865f2";
            const qName = q.config?.messages?.questName || q.id;
            return `<div class="quest" data-id="${q.id}" style="--quest-color: ${color}">
              <div class="quest-title">
                <label class="checkbox-label">
                  <input type="checkbox" data-id="${q.id}" ${selected.has(q.id) ? "checked" : ""}>
                  <span class="custom-checkbox"></span>
                  <span class="quest-name" title="${qName}">${qName}</span>
                </label>
                <span class="task-badge" style="--task-color: ${color}">${t.taskName.replace(/_/g, " ")}</span>
              </div>
              <div class="progress-bar"><div class="progress-fill"></div></div>
              <div class="progress-text"><span class="cur">0s</span><span class="tgt">0s</span></div>
            </div>`;
          }).join("");
          
          listEl.querySelectorAll("input[type=checkbox]").forEach(cb => {
            cb.addEventListener("change", () => {
              if (cb.checked) selected.add(cb.dataset.id); else selected.delete(cb.dataset.id);
            });
          });
        }
      }
      
      quests.forEach(q => {
        const el = listEl.querySelector(`.quest[data-id="${q.id}"]`); if (!el) return;
        const t = getQuestTask(q); if (!t) return;
        const { current, target } = getQuestProgress(q);
        const pct = target > 0 ? Math.min(100, (current / target) * 100) : 0;
        el.querySelector(".progress-fill").style.width = pct + "%";
        el.querySelector(".cur").textContent = `${current}s`;
        el.querySelector(".tgt").textContent = `${target}s`;
        el.classList.toggle("running", jobs.has(q.id));
      });
    } catch (e) {
      console.error("[QM] Render Error:", e);
    }
  };
  
  const renderInterval = setInterval(render, 1500);
  render();

  btnFilter.addEventListener("click", () => {
    orbsOnly = !orbsOnly;
    btnFilter.classList.toggle("active", orbsOnly);
    btnFilter.textContent = orbsOnly ? "☄️ Orbs Only (ON)" : "☄️ Orbs Only";
    render();
  });

  btnEnroll.addEventListener("click", async () => {
    const unenrolled = getUnenrolledQuests();
    if (!unenrolled.length) return;
    btnEnroll.disabled = true;

    const total = unenrolled.length;
    let enrolledCount = 0, playedCount = 0;

    for (const q of unenrolled) {
      const qName = q.config?.messages?.questName || q.id;
      try {
        await api.post({
          url: `/quests/${q.id}/enroll`,
          body: { location: 11, is_targeted: false, metadata_raw: null }
        });
        enrolledCount++;
        log(`✅ Enrolled: ${qName}`, "success");

        if (autoPlay) {
          const fresh = await waitForEnroll(q.id, 5000);
          if (fresh && !jobs.has(fresh.id)) {
            runJob(fresh);
            playedCount++;
            log(`▶ Auto-Play Started: ${qName}`, "info");
          }
        }
      } catch (e) {
        log(`❌ Failed to enroll ${qName}: ${e.message}`, "error");
      }
      await new Promise(r => setTimeout(r, autoPlay ? 800 : 1200));
    }

    if (autoPlay) log(`[DONE] ${enrolledCount}/${total} enrolled, ${playedCount} auto-played.`, "success");
    render();
  });

  btnEnroll.addEventListener("contextmenu", (e) => {
    e.preventDefault();
    if (btnEnroll.disabled) return;
    autoPlay = !autoPlay;
    setAutoPlay(autoPlay);
    log(`Auto-Play after enroll: ${autoPlay ? "ON" : "OFF"}`, autoPlay ? "success" : "warn");
    render();
  });

  $("startSel").addEventListener("click", () => {
    const qs = getEligibleQuests().filter(q => selected.has(q.id));
    if (!qs.length) return log("No quests selected.", "warn");
    qs.forEach(runJob); render();
  });
  
  $("startAll").addEventListener("click", () => {
    const qs = getEligibleQuests(); if (!qs.length) return log("No eligible quests.", "warn");
    qs.forEach(runJob); render();
  });
  
  $("stopAll").addEventListener("click", () => {
    [...jobs.keys()].forEach(stopJob); render();
  });

  minimizeBtn.addEventListener("click", minimizePanel);
  $("closeBtn").addEventListener("click", () => openModal("Close Quest Manager?", "Any running quests will be stopped immediately.", "Close", true, () => window.dispatchEvent(new Event("dc-quest-manager-cleanup"))));

  const getUpdateUrl = () => { try { return (localStorage.getItem(UPDATE_URL_KEY) || DEFAULT_UPDATE_URL).trim(); } catch { return DEFAULT_UPDATE_URL; } };
  const saveUpdateUrl = (url) => { try { if (url) localStorage.setItem(UPDATE_URL_KEY, url.trim()); else localStorage.removeItem(UPDATE_URL_KEY); } catch {} };
  const isUpdateConfigured = () => { const u = getUpdateUrl(); return !!u && !u.includes("YOUR_USER"); };

  const parseVersion = (v) => {
    if (!v) return null;
    const m = String(v).trim().replace(/^v/i, "").match(/^(\d+)\.(\d+)\.(\d+)(?:-([\w.]+))?$/);
    return m ? { major: +m[1], minor: +m[2], patch: +m[3], pre: m[4] || "" } : null;
  };
  const cmpVersion = (a, b) => {
    const va = parseVersion(a), vb = parseVersion(b);
    if (!va || !vb) return String(a).localeCompare(String(b));
    for (const k of ["major", "minor", "patch"]) { if (va[k] !== vb[k]) return va[k] - vb[k]; }
    if (va.pre === vb.pre) return 0;
    if (!va.pre) return 1;
    if (!vb.pre) return -1;
    return va.pre.localeCompare(vb.pre);
  };

  const fetchWithTimeout = async (url, ms = 15000) => {
    const ctrl = new AbortController();
    const timer = setTimeout(() => ctrl.abort(), ms);
    try { return await fetch(url, { signal: ctrl.signal, cache: "no-store" }); }
    finally { clearTimeout(timer); }
  };

  const extractRemoteMeta = (text) => {
    const versionMatch = text.match(/(?:const|let|var)\s+VERSION\s*=\s*["']([^"']+)["']/);
    const authorMatch  = text.match(/(?:const|let|var)\s+AUTHOR\s*=\s*["']([^"']+)["']/);
    const changelogMatch = text.match(/\/\*\s*CHANGELOG\s*([\s\S]*?)\*\//i);
    const lines = (changelogMatch?.[1] || "").split("\n").map(l => l.replace(/^\s*\*?\s?/, "").trim()).filter(Boolean);
    return { version: versionMatch?.[1] || null, author: authorMatch?.[1] || null, changelog: lines.length ? lines : null, size: new Blob([text]).size };
  };

  const setUpdateBtn = (state, label) => {
    btnUpd.className = "update" + (state ? " " + state : "");
    btnUpd.innerHTML = `<span>${label}</span>`;
  };
  const resetUpdateBtn = () => setUpdateBtn("", "⟳ Check Update");

  const promptUpdateUrl = () => {
    const current = getUpdateUrl();
    const def = current === DEFAULT_UPDATE_URL ? "" : current;
    let url;
    try { url = prompt("Enter the raw script URL (e.g. GitHub raw link).\nLeave empty to reset to default.", def); } catch { return; }
    if (url === null) return;
    saveUpdateUrl(url.trim());
    if (isUpdateConfigured()) { log("Update URL saved.", "success"); checkUpdate(false); }
  };

  let currentRemoteText = null;

  const showUpdateModal = (meta, text) => {
    currentRemoteText = text;
    const parts = [`A new version (v${meta.version}) is available.`];
    if (meta.author && meta.author !== AUTHOR) parts.push(`By ${meta.author}`);
    if (meta.size) parts.push(`Size: ${(meta.size / 1024).toFixed(1)} KB`);
    if (meta.changelog?.length) parts.push("What's new:\n• " + meta.changelog.join("\n• "));
    parts.push("The panel will reload.");

    openModal(`Update to v${meta.version}?`, parts.join("\n\n"), "Update Now", false, async () => {
      try {
        window.dispatchEvent(new Event("dc-quest-manager-cleanup"));
        await new Promise(r => setTimeout(r, 200));
        new Function(currentRemoteText)();
      } catch (e) { alert("Update failed to run:\n" + e.message); }
    });
  };

  const checkUpdate = async (silent = false) => {
    if (!isUpdateConfigured()) {
      if (!silent) openModal("Configure Updater", "Set the raw script URL to enable auto-updates.\nRight-click the button to change it later.", "Set URL", false, promptUpdateUrl);
      return;
    }
    setUpdateBtn("loading", "⟳ Checking...");
    try {
      const baseUrl = getUpdateUrl();
      const url = baseUrl + (baseUrl.includes("?") ? "&" : "?") + "_t=" + Date.now();
      const res = await fetchWithTimeout(url);
      if (!res.ok) throw new Error(`HTTP ${res.status} ${res.statusText}`);
      const text = await res.text();
      const meta = extractRemoteMeta(text);
      
      if (!meta.version) throw new Error("Remote VERSION not found.");
      if (!parseVersion(meta.version)) throw new Error(`Invalid remote version: ${meta.version}`);

      const cmp = cmpVersion(meta.version, VERSION);
      if (cmp <= 0) {
        setUpdateBtn("success", "✅ Up to date");
        setTimeout(resetUpdateBtn, 3000);
        return;
      }

      setUpdateBtn("available", `v${meta.version} Available`);
      if (!silent) showUpdateModal(meta, text);
    } catch (e) {
      setUpdateBtn("error", "❌ Failed");
      log(`Update failed: ${e.message}`, "error");
      if (!silent) alert(`Update failed: ${e.message}`);
      setTimeout(resetUpdateBtn, 5000);
    }
  };

  btnUpd.addEventListener("click", () => checkUpdate(false));
  btnUpd.addEventListener("contextmenu", (e) => { e.preventDefault(); promptUpdateUrl(); });

  window.addEventListener("dc-quest-manager-cleanup", () => {
    clearInterval(renderInterval);
    [...jobs.keys()].forEach(stopJob);
    root.remove();
  });

  log(`Quest Manager v${VERSION} loaded by ${AUTHOR}.`, "success");
  if (!isApp) log("Browser detected: Desktop quests won't work.", "warn");
  if (isUpdateConfigured()) setTimeout(() => checkUpdate(true), 3000);
})();
